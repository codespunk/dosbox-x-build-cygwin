#!/usr/bin/env bash

# Build native Windows binaries using MinGW-w64 from Cygwin.
# Usage: ./build-cygwin [32] [-i|--incremental] [--with-sdl] [--with-libpng] [--only-COMPONENT] [configure options...]
#        ./build-cygwin --help
set -e

show_help() {
    cat <<'EOF'
Usage: ./build-cygwin [32] [options] [configure options...]
       ./build-cygwin --help

Build DOSBox-X for 32-bit or 64-bit Windows from Cygwin using MinGW-w64.

Options:
  32                 Target 32-bit Windows (i686-w64-mingw32).
                     Default: 64-bit Windows (x86_64-w64-mingw32).
  -h, --help         Display this help message and exit.

Incremental Builds:
  -i, --incremental  Rebuild changed files without rebuilding bundled libraries.
  --with-sdl         Also rebuild SDL and SDL_net.
  --with-libpng      Also rebuild bundled libpng.

Component Builds:
  --only-NAME        Compile only src/NAME without linking the executable.
  --only-sdl         Rebuild bundled SDL and SDL_net only.
  --only-sdlnet      Rebuild bundled SDL_net only.
  --only-libpng      Rebuild bundled static libpng only.

Additional Information:
  Full builds check dependencies, configure the toolchain, patch SDL when
  necessary, and build bundled libraries before compiling DOSBox-X.

  Incremental builds skip dependency checks and bundled libraries unless
  explicitly requested. Component builds are incremental and do not link
  the final executable.

  Additional configure options are forwarded to the repository's ./build.

Examples:
  ./build-cygwin                     Full 64-bit build
  ./build-cygwin 32                  Full 32-bit build
  ./build-cygwin -i                  Incremental 64-bit build
  ./build-cygwin 32 -i               Incremental 32-bit build
  ./build-cygwin -i --with-sdl       Incremental build, rebuild SDL/SDL_net
  ./build-cygwin -i --with-libpng    Incremental build, rebuild libpng
  ./build-cygwin --only-cpu          Compile CPU component only
  ./build-cygwin --only-dos          Compile DOS component only
  ./build-cygwin --only-sdl          Rebuild SDL and SDL_net only
  ./build-cygwin --only-libpng       Rebuild libpng only
EOF
}

build32=no
incremental=no
with_sdl=no
with_libpng=no
only_component=""
configure_args=()
for arg in "$@"; do
    case "$arg" in
        -h|--help) show_help; exit 0 ;;
        32) build32=yes ;;
        -i|--incremental) incremental=yes ;;
        --only-*)
            if [ -n "$only_component" ]; then
                echo "Specify only one --only-COMPONENT option." >&2
                exit 1
            fi
            only_component="${arg#--only-}"
            incremental=yes
            ;;
        --with-sdl) with_sdl=yes ;;
        --with-libpng|--width-libpng) with_libpng=yes ;;
        *) configure_args+=("$arg") ;;
    esac
done

check_cygwin_dependencies() {
    local arch=$1 package
    local -a packages missing

    packages=(
        autoconf automake gcc-core gcc-g++ libtool
        "mingw64-${arch}-gcc-core"
        "mingw64-${arch}-gcc-g++"
        "mingw64-${arch}-headers"
        "mingw64-${arch}-ncurses"
        "mingw64-${arch}-runtime"
        "mingw64-${arch}-win-iconv"
        "mingw64-${arch}-zlib"
        nasm pkg-config patch
    )

    if ! command -v cygcheck >/dev/null 2>&1; then
        echo "Cannot check Cygwin dependencies: cygcheck is unavailable" >&2
        return 1
    fi

    missing=()
    for package in "${packages[@]}"; do
        if ! cygcheck -c "$package" 2>/dev/null |
            awk -v pkg="$package" '$1 == pkg && $NF == "OK" { found = 1 } END { exit !found }'; then
            missing+=("$package")
        fi
    done

    if ((${#missing[@]})); then
        echo "Missing or incomplete Cygwin packages:" >&2
        printf '  %s\n' "${missing[@]}" >&2
        echo "Install these packages using the Cygwin setup program" >&2
        return 1
    fi

    echo "All required Cygwin packages are installed"
}

# Apply the compatibility patch to SDL's Autoconf source and generated configure.
# Check both files together to avoid leaving SDL partially patched.
apply_sdl_compat_patch() {
    local sdl_dir=vs/sdl
    local file
    local -a needs_patch=()
    local -a already_patched=()

    for file in configure.ac configure; do
        if [ ! -f "$sdl_dir/$file" ]; then
            echo "Missing SDL configuration file: $sdl_dir/$file" >&2
            return 1
        fi
        if sdl_patch "$file" | patch --batch --forward --dry-run --fuzz=0 -p1 -d "$sdl_dir" >/dev/null 2>&1; then
            needs_patch+=("$file")
        elif sdl_patch "$file" | patch --batch --dry-run --fuzz=0 -R -p1 -d "$sdl_dir" >/dev/null 2>&1; then
            already_patched+=("$file")
        else
            echo "SDL $file differs from both the expected original and patched versions." >&2
            echo "No SDL files were modified. Inspect $sdl_dir/$file before continuing." >&2
            return 1
        fi
    done

    if ((${#needs_patch[@]})); then
        echo "Applying SDL -mno-cygwin compatibility patch: ${needs_patch[*]}"
        for file in "${needs_patch[@]}"; do
            sdl_patch "$file" | patch --batch --forward --fuzz=0 -p1 -d "$sdl_dir" || return 1
        done
    else
        echo "SDL -mno-cygwin compatibility patch already applied"
    fi
}

# Embedded patches taken from the supplied original and Cygwin-adjusted SDL files.
sdl_patch() {
    case "$1" in
        configure.ac)
            cat <<'SDL_CONFIGURE_AC_PATCH'
--- a/configure.ac
+++ b/configure.ac
@@ -73,9 +73,22 @@
 fi
 case "$host" in
     *-*-cygwin*)
-        # We build SDL on cygwin without the UNIX emulation layer
-        BASE_CFLAGS="-I/usr/include/mingw -mno-cygwin"
-        BASE_LDFLAGS="-mno-cygwin"
+        # Legacy Cygwin GCC may support native Windows builds via -mno-cygwin.
+        # Modern MinGW-w64 GCC does not need or accept this option.
+        save_CFLAGS="$CFLAGS"
+        have_no_cygwin=no
+        AC_MSG_CHECKING(for GCC -mno-cygwin option)
+        CFLAGS="$save_CFLAGS -mno-cygwin"
+        AC_COMPILE_IFELSE([AC_LANG_PROGRAM([],[])], [have_no_cygwin=yes], [])
+        AC_MSG_RESULT($have_no_cygwin)
+        CFLAGS="$save_CFLAGS"
+
+        BASE_CFLAGS=""
+        BASE_LDFLAGS=""
+        if test x$have_no_cygwin = xyes; then
+            BASE_CFLAGS="-I/usr/include/mingw -mno-cygwin"
+            BASE_LDFLAGS="-mno-cygwin"
+        fi
         ;;
     *)
         BASE_CFLAGS="-D_GNU_SOURCE=1"
SDL_CONFIGURE_AC_PATCH
            ;;
        configure)
            cat <<'SDL_CONFIGURE_PATCH'
--- a/configure
+++ b/configure
@@ -15821,9 +15821,41 @@
 fi
 case "$host" in
     *-*-cygwin*)
-        # We build SDL on cygwin without the UNIX emulation layer
-        BASE_CFLAGS="-I/usr/include/mingw -mno-cygwin"
-        BASE_LDFLAGS="-mno-cygwin"
+        # Legacy Cygwin GCC may support native Windows builds via -mno-cygwin.
+        # Modern MinGW-w64 GCC does not need or accept this option.
+        save_CFLAGS="$CFLAGS"
+        have_no_cygwin=no
+        { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for GCC -mno-cygwin option" >&5
+printf %s "checking for GCC -mno-cygwin option... " >&6; }
+        CFLAGS="$save_CFLAGS -mno-cygwin"
+
+        cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+/* end confdefs.h.  */
+
+int
+main (void)
+{
+
+  ;
+  return 0;
+}
+_ACEOF
+if { (eval echo "$as_me:$LINENO: \"$ac_compile\"") >&5
+     (eval "$ac_compile") 2>&5
+     ac_status=$?
+     echo "$as_me:$LINENO: \$? = $ac_status" >&5
+     test $ac_status -eq 0; } && test -s conftest.$ac_objext; then
+  have_no_cygwin=yes
+fi
+rm -f core conftest.err conftest.$ac_objext conftest.beam conftest.$ac_ext
+        { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $have_no_cygwin" >&5
+printf "%s\n" "$have_no_cygwin" >&6; }
+        CFLAGS="$save_CFLAGS"
+
+        if test x$have_no_cygwin = xyes; then
+            BASE_CFLAGS="-I/usr/include/mingw -mno-cygwin"
+            BASE_LDFLAGS="-mno-cygwin"
+        fi
         ;;
     *)
         BASE_CFLAGS="-D_GNU_SOURCE=1"
SDL_CONFIGURE_PATCH
            ;;
        *) return 1 ;;
    esac
}

case "$(uname -s)" in
    CYGWIN*) echo "Cygwin environment detected" ;;
    *) echo "This helper requires Cygwin" >&2; exit 1 ;;
esac

if [ "$build32" = yes ]; then
    arch=i686
else
    arch=x86_64
fi
triplet="${arch}-w64-mingw32"
mingw_prefix="/usr/$triplet/sys-root/mingw"

if [ "$incremental" != yes ]; then
    echo "Checking for preflight dependencies..."
    check_cygwin_dependencies "$arch" || exit 1
fi

if ! command -v "$triplet-gcc" >/dev/null 2>&1 ||
   ! command -v "$triplet-g++" >/dev/null 2>&1; then
    echo "Missing MinGW-w64 cross-compiler for $triplet" >&2
    exit 1
fi

if [ ! -d "$mingw_prefix" ]; then
    echo "Missing MinGW-w64 sysroot: $mingw_prefix" >&2
    exit 1
fi

export PATH="$mingw_prefix/bin:$PATH"
export CC="$triplet-gcc"
export CXX="$triplet-g++"
export MINGW_PREFIX="$mingw_prefix"

# Bundled static libpng and the MinGW-w64 target libraries.
png_prefix="$(pwd)/vs/libpng/linux-host"
export CPPFLAGS="-I$png_prefix/include -I$mingw_prefix/include ${CPPFLAGS:-}"
export LDFLAGS="-L$png_prefix/lib -L$mingw_prefix/lib ${LDFLAGS:-}"

# Retain the original helper's Windows device-property linkage workaround.
export LIBS="${LIBS:-} -luuid"

if [ "$incremental" = yes ]; then
    if [ -n "$only_component" ] && { [ "$with_sdl" = yes ] || [ "$with_libpng" = yes ]; }; then
        echo "--only-COMPONENT cannot be combined with --with-sdl or --with-libpng." >&2
        exit 1
    fi
    if ((${#configure_args[@]})); then
        echo "Configure options cannot be used with --incremental; run a full build instead." >&2
        exit 1
    fi

    if [ ! -f Makefile ] || [ ! -f config.status ]; then
        echo "No configured DOSBox-X build found. Run a full ./build-cygwin build first." >&2
        exit 1
    fi

    # Avoid mixing 32-bit and 64-bit objects in the same build directory.
    configured_host="$(sed -n 's/^host = //p' Makefile | head -n 1)"
    configured_cc="$(sed -n 's/^CC = //p' Makefile | head -n 1)"
    configured_cxx="$(sed -n 's/^CXX = //p' Makefile | head -n 1)"
    if [ "$configured_host" != "$triplet" ] ||
       [[ "$configured_cc" != "$triplet-gcc"* ]] ||
       [[ "$configured_cxx" != "$triplet-g++"* ]]; then
        echo "Existing build is not configured for $triplet." >&2
        echo "Configured host: ${configured_host:-unknown}" >&2
        echo "Configured CC: ${configured_cc:-unknown}" >&2
        echo "Configured CXX: ${configured_cxx:-unknown}" >&2
        echo "Run a full build for the requested architecture first." >&2
        exit 1
    fi

    # A component-only build intentionally does not link the final executable.
    # Discover top-level components from the configured source tree.
    if [ -n "$only_component" ]; then
        case "$only_component" in
            sdl)
                apply_sdl_compat_patch || exit 1
                echo "Rebuilding bundled SDL 1.x"
                (cd vs/sdl && ./build-dosbox.sh) || exit 1
                echo "Rebuilding bundled SDL_net 1.x"
                (cd vs/sdlnet && ./build-dosbox.sh) || exit 1
                ;;
            sdlnet)
                echo "Rebuilding bundled SDL_net 1.x"
                (cd vs/sdlnet && ./build-dosbox.sh) || exit 1
                ;;
            libpng)
                echo "Rebuilding bundled static libpng"
                (cd vs/libpng && ./build-dosbox.sh) || exit 1
                ;;
            include)
                echo "Building include component"
                make --no-print-directory -C include -j"$(nproc)" || exit 1
                ;;
            *)
                # Restrict component names to a single existing src subdirectory.
                if [[ ! "$only_component" =~ ^[a-zA-Z0-9_+-]+$ ]] ||
                   [ ! -f "src/$only_component/Makefile" ]; then
                    echo "Unknown component: $only_component" >&2
                    echo "Expected a configured src/<component>/Makefile." >&2
                    exit 1
                fi
                echo "Incrementally building src/$only_component for $triplet (no final link)"
                make --no-print-directory -C "src/$only_component" -j"$(nproc)" || exit 1
                ;;
        esac
        exit 0
    fi

    # Rebuild bundled libraries only when explicitly requested.
    if [ "$with_sdl" = yes ]; then
        apply_sdl_compat_patch || exit 1
        echo "Rebuilding bundled SDL 1.x"
        (cd vs/sdl && ./build-dosbox.sh) || exit 1
        echo "Rebuilding bundled SDL_net 1.x"
        (cd vs/sdlnet && ./build-dosbox.sh) || exit 1
    fi
    if [ "$with_libpng" = yes ]; then
        echo "Rebuilding bundled static libpng"
        (cd vs/libpng && ./build-dosbox.sh) || exit 1
    fi

    echo "Incrementally building DOSBox-X for $triplet"
    exec make --no-print-directory -j"$(nproc)"
fi

apply_sdl_compat_patch || exit 1

echo "Compiling our internal libpng"
(cd vs/libpng && ./build-dosbox.sh) || exit 1

# Do not forward '32': the original ./build treats it as a Linux -m32 build.
./build "--host=$triplet" "${configure_args[@]}"
